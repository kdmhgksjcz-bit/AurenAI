{
  "expo": {
    "name": "AUREN AI",
    "slug": "auren-ai",
    "scheme": "auren",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "AUREN uses your camera only when you choose to take a hair or skin scan.",
          "microphonePermission": "AUREN does not record audio.",
          "recordAudioAndroid": false
        }
      ],
      "expo-router"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.auren.studio"
    },
    "android": {
      "package": "ai.auren.studio"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}